{
  "name": "omni-it-copilot",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" .",
    "lint:fix": "eslint --fix .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
