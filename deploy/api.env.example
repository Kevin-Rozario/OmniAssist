NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Exact browser origins. Wildcards are rejected.
# Add each Vercel preview origin here when that deployment should call the API.
WEB_ORIGINS=https://omniassist.kevinrozario.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# Knowledge base — see deploy/README.md (Knowledge base and Inngest).
# Placeholders only; never commit real secrets.
R2_ACCOUNT_ID=replace_me_account_id
R2_ACCESS_KEY_ID=replace_me_access_key
R2_SECRET_ACCESS_KEY=replace_me_secret_access_key
R2_BUCKET=omniassist-kb
# R2_ENDPOINT=https://replace_me_account_id.r2.cloudflarestorage.com
PINECONE_API_KEY=replace_me_pinecone_key
PINECONE_INDEX=omniassist-kb
INNGEST_SIGNING_KEY=signkey-replace_me
INNGEST_EVENT_KEY=replace_me_event_key
KB_MAX_UPLOAD_BYTES=10485760
