# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of web app origins allowed to call the API (CORS and Clerk authorized parties).
WEB_ORIGINS=http://localhost:3001

# Neon pooled connection string (the "-pooler" host).
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/omni?sslmode=require
# Neon direct (non-pooled) connection string, used only by drizzle-kit in packages/db.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/omni?sslmode=require

# Clerk dashboard → API keys. Copy the dev instance values into apps/api/.env (gitignored).
# Customize the session token (Sessions → Customize session token) with:
#   { "metadata": "{{user.public_metadata}}" }
# Create one admin user (public_metadata.role = "admin") and one member user.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# --- Knowledge base (R2, Pinecone, Inngest) ---
# Create these outside the app before upload/ingest will succeed. /ready only checks Postgres.

# Cloudflare R2: create a private bucket, then an API token with Object Read & Write on that bucket.
# R2_ENDPOINT is optional; when unset the API uses https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ACCOUNT_ID=replace_me_account_id
R2_ACCESS_KEY_ID=replace_me_access_key
R2_SECRET_ACCESS_KEY=replace_me_secret_access_key
R2_BUCKET=omniassist-kb
# R2_ENDPOINT=https://replace_me_account_id.r2.cloudflarestorage.com

# Pinecone document index. Schema rows:
#   chunk_text  string, embed text-embedding-3-small, 1536, cosine, English full-text
#   title       string, English full-text
# Ingestion upserts plain text. Pinecone embeds chunk_text. Do not add more schema rows.
PINECONE_API_KEY=replace_me_pinecone_key
PINECONE_INDEX=omniassist-kb

# Inngest Cloud: create an app and set the serve URL to https://<api-host>/api/inngest
# (local: http://127.0.0.1:3000/api/inngest). After deploying the API, sync/register
# functions in the Inngest dashboard so kb/ingest-document receives events.
# Copy Event Key → INNGEST_EVENT_KEY and Signing Key → INNGEST_SIGNING_KEY.
# Local dev: run `npx inngest-cli@latest dev -u http://127.0.0.1:3000/api/inngest` and set
# INNGEST_DEV=1 so events go to the local dev server instead of Inngest Cloud.
# INNGEST_DEV=1
INNGEST_SIGNING_KEY=signkey-replace_me
INNGEST_EVENT_KEY=replace_me_event_key

# Max knowledge-base upload size in bytes (default 10 MiB). Rejected before storage.
KB_MAX_UPLOAD_BYTES=10485760

# Ask pipeline (POST /v1/ask). All four are required; the API refuses to start without them.
OPENAI_API_KEY=replace_me_openai_key
# Model that writes the streamed answer (no default on purpose; use a model your key can access).
OPENAI_ANSWER_MODEL=replace_me_answer_model
TYPESAFE_API_KEY=replace_me_typesafe_key
TAVILY_API_KEY=replace_me_tavily_key
# Optional (defaults shown). TYPESAFE_MODEL routes and grades; KB_RETRIEVAL_TOP_K is 1-20;
# ASK_TIMEOUT_MS is the whole-request deadline.
# TYPESAFE_MODEL=jev-1.14.0
# KB_RETRIEVAL_TOP_K=8
# ASK_TIMEOUT_MS=60000
