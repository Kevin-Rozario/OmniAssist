# Clerk dashboard → API keys. Use the same dev instance as apps/api.
# Copy these into apps/web/.env.local (gitignored).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Browser calls this origin directly. Local API default is port 3000.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional. The signed-in Playwright test uses this user when set.
# Otherwise it picks the Clerk user whose public_metadata.role is "admin".
# E2E_CLERK_USER_EMAIL=admin@example.com

# Local routes. The Next.js proxy redirects unauthenticated visitors here
# and returns them to the page they requested after sign-in.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
